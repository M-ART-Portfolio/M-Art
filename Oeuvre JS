/* ===== Petites fonctions partagées par toutes les pages ===== */

/* Stockage protégé : ne plante jamais, même en navigation privée */
function storeGet(key) {
  try { return localStorage.getItem(key); } catch (e) { return null; }
}
function storeSet(key, value) {
  try { localStorage.setItem(key, value); } catch (e) { /* ignoré */ }
}

function getLang() {
  return storeGet("mart-lang") || "fr";
}

/* Dates de l'artiste : texte, vide, ou { fr, en } */
function artistDates(o, lang) {
  if (!o.dates) return "";
  return (typeof o.dates === "object") ? (o.dates[lang] || "") : o.dates;
}

/* Assemble des morceaux non vides : joinParts(["a","","b"], " · ") → "a · b" */
function joinParts(parts, sep) {
  return parts.filter(Boolean).join(sep);
}

function applyUI(lang, extra) {
  const dict = extra ? Object.assign({}, UI[lang], extra[lang]) : UI[lang];
  document.documentElement.lang = lang;
  document.querySelectorAll("[data-i18n]").forEach(function (el) {
    const key = el.dataset.i18n;
    if (dict[key] !== undefined) el.innerHTML = dict[key];
  });
  document.querySelectorAll(".lang-btn").forEach(function (btn) {
    btn.classList.toggle("active", btn.dataset.lang === lang);
  });
}

function initLangButtons(onChange) {
  document.querySelectorAll(".lang-btn").forEach(function (btn) {
    btn.addEventListener("click", function () {
      storeSet("mart-lang", btn.dataset.lang);
      onChange(btn.dataset.lang);
    });
  });
}

function initChrome() {
  /* Barre de progression */
  const bar = document.getElementById("progressBar");
  if (bar) {
    window.addEventListener("scroll", function () {
      const h = document.body.scrollHeight - window.innerHeight;
      bar.style.width = (h > 0 ? (window.scrollY / h) * 100 : 0) + "%";
    }, { passive: true });
  }
  /* Nav au scroll */
  const nav = document.getElementById("mainNav");
  if (nav) {
    window.addEventListener("scroll", function () {
      nav.classList.toggle("scrolled", window.scrollY > 60);
    }, { passive: true });
  }
  /* Transitions de page (délégation : marche aussi sur les liens créés en JS) */
  const overlay = document.getElementById("pageTransition");
  document.addEventListener("click", function (e) {
    const link = e.target.closest("a.page-link");
    if (!link) return;
    const href = link.getAttribute("href");
    if (!href || href.charAt(0) === "#") return;
    e.preventDefault();
    if (overlay) overlay.classList.add("active");
    setTimeout(function () { window.location.href = href; }, 360);
  });
  window.addEventListener("pageshow", function () {
    if (overlay) overlay.classList.remove("active");
  });
}
