<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>M·Art — Œuvre</title>
  <meta name="description" content="M·Art — une œuvre choisie, son histoire et un regard personnel.">
  <meta name="theme-color" content="#1a1814">

  <meta property="og:type" content="article">
  <meta property="og:title" content="M·Art — Œuvre">
  <meta property="og:description" content="Une œuvre choisie, son histoire et un regard personnel.">
  <meta property="og:image" content="https://flambardgautier-wq.github.io/M-Art/lady.png">

  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%231a1814'/%3E%3Ctext x='32' y='44' font-family='Georgia,serif' font-size='34' font-style='italic' fill='%23c4a06a' text-anchor='middle'%3EM%3C/text%3E%3C/svg%3E">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&family=Jost:wght@200;300;400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="style.css">
</head>
<body>

  <div class="progress-bar" id="progressBar"></div>
  <div class="page-transition" id="pageTransition"></div>

  <!-- NAVIGATION -->
  <nav class="nav" id="mainNav">
    <a href="index.html" class="nav-brand page-link">M·Art</a>
    <div class="nav-right">
      <div class="nav-links">
        <a href="index.html" class="nav-link active page-link" data-i18n="nav.works">Œuvres</a>
        <a href="presentation.html" class="nav-link page-link" data-i18n="nav.about">À propos</a>
      </div>
      <div class="lang-switcher">
        <button class="lang-btn active" data-lang="fr" aria-label="Français">FR</button>
        <span class="lang-sep">·</span>
        <button class="lang-btn" data-lang="en" aria-label="English">EN</button>
      </div>
    </div>
  </nav>

  <!-- MUR DE MUSÉE -->
  <section class="stage">
    <div class="hero-bg"></div>
    <div class="hero-noise"></div>

    <a href="index.html" class="stage-back page-link">
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M13 8H3M7 4L3 8l4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <span data-i18n="o.back">La collection</span>
    </a>

    <div class="stage-inner">
      <figure class="stage-frame">
        <button class="stage-zoom" id="focusBtn" title="Agrandir" aria-label="Agrandir l'image">
          <svg width="16" height="16" viewBox="0 0 18 18" fill="none" aria-hidden="true">
            <path d="M2 2h5M2 2v5M16 2h-5M16 2v5M2 16h5M2 16v-5M16 16h-5M16 16v-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </button>
        <div class="stage-mat">
          <img src="" alt="" id="artImg">
        </div>
      </figure>

      <!-- Cartel, comme au musée -->
      <aside class="plaque" aria-label="Cartel de l'œuvre">
        <p class="plaque-artist" id="plArtist"></p>
        <p class="plaque-title" id="plTitle"></p>
        <p class="plaque-line" id="plTech"></p>
        <p class="plaque-loc" id="plLieu"></p>
      </aside>
    </div>
  </section>

  <!-- CONTENU -->
  <main class="container">
    <article class="oeuvre-body">
      <div class="art-meta">
        <span class="art-tag-plain" id="oTag"></span>
        <span class="art-sep" aria-hidden="true">·</span>
        <span class="art-number" id="oNum"></span>
      </div>

      <h1 class="oeuvre-title" id="oTitle"></h1>
      <p class="oeuvre-artist" id="oArtist"></p>

      <div class="art-divider"></div>

      <div class="tabs" role="tablist">
        <button class="tab active" data-tab="regard" data-i18n="o.tab.regard">Mon regard</button>
        <button class="tab" data-tab="histoire" data-i18n="o.tab.histoire">Histoire &amp; contexte</button>
      </div>

      <div class="tab-content active" id="tab-regard"></div>
      <div class="tab-content" id="tab-histoire"></div>
    </article>

    <!-- Œuvre précédente / suivante -->
    <nav class="oeuvre-nav" id="oeuvreNav" aria-label="Autres œuvres"></nav>
  </main>

  <!-- LIGHTBOX -->
  <div class="lightbox" id="lightbox" role="dialog" aria-modal="true">
    <button class="lightbox-close" id="lightboxClose" aria-label="Fermer">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 4l12 12M16 4L4 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
    </button>
    <div class="lightbox-img-wrap">
      <img src="" alt="" id="lightboxImg">
      <p class="lightbox-caption" id="lightboxCaption"></p>
    </div>
  </div>

  <!-- FOOTER -->
  <footer class="site-footer">
    <div class="footer-inner container">
      <p class="footer-brand">M·Art</p>
      <p class="footer-copy" data-i18n="footer.copy">Un regard personnel sur l'art qui marque.</p>
      <a href="index.html" class="footer-link page-link" data-i18n="footer.works">Œuvres →</a>
    </div>
  </footer>

  <script src="oeuvres.js"></script>
  <script>
    // =============================================
    // ŒUVRE COURANTE (depuis l'adresse ?id=...)
    // =============================================
    const params = new URLSearchParams(window.location.search);
    const idx = OEUVRES.findIndex(function (o) { return o.id === params.get("id"); });

    if (idx === -1) {
      // id inconnu ou absent → retour à la collection
      window.location.replace("index.html");
      throw new Error("Œuvre introuvable");
    }

    const oeuvre = OEUVRES[idx];
    function pad(n) { return String(n).padStart(3, "0"); }

    function renderOeuvre(lang) {
      const d = oeuvre[lang];
      const t = UI[lang];

      // Image + cartel
      const img = document.getElementById("artImg");
      img.src = oeuvre.image;
      img.alt = d.titreCourt + " — " + oeuvre.artiste;

      document.getElementById("plArtist").textContent = oeuvre.artiste + " (" + oeuvre.dates + ")";
      document.getElementById("plTitle").innerHTML = "<em>" + d.titreCourt + "</em>, " + oeuvre.annee;
      document.getElementById("plTech").textContent = d.technique + " — " + d.dimensions;
      document.getElementById("plLieu").textContent = d.lieu;

      // Corps
      document.getElementById("oTag").textContent = d.tag;
      document.getElementById("oNum").textContent = "N° " + pad(idx + 1);
      document.getElementById("oTitle").innerHTML = d.titre;
      document.getElementById("oArtist").textContent = oeuvre.artiste + " (" + oeuvre.dates + ")";

      document.getElementById("tab-regard").innerHTML =
        d.regard.map(function (p) { return "<p>" + p + "</p>"; }).join("");
      document.getElementById("tab-histoire").innerHTML =
        d.histoire.map(function (p) { return "<p>" + p + "</p>"; }).join("");

      // Lightbox
      document.getElementById("lightboxImg").src = oeuvre.image;
      document.getElementById("lightboxImg").alt = img.alt;
      document.getElementById("lightboxCaption").textContent =
        d.titreCourt + " — " + oeuvre.artiste + ", " + oeuvre.annee;

      // Précédente / suivante
      const nav = document.getElementById("oeuvreNav");
      const prev = OEUVRES[idx - 1];
      const next = OEUVRES[idx + 1];
      let html = "";
      if (prev) {
        html +=
          '<a class="onav onav-prev page-link" href="oeuvre.html?id=' + prev.id + '">' +
            '<span class="onav-label">← ' + t["o.prev"] + '</span>' +
            '<span class="onav-title">' + prev[lang].titreCourt + '</span>' +
          '</a>';
      }
      if (next) {
        html +=
          '<a class="onav onav-next page-link" href="oeuvre.html?id=' + next.id + '">' +
            '<span class="onav-label">' + t["o.next"] + ' →</span>' +
            '<span class="onav-title">' + next[lang].titreCourt + '</span>' +
          '</a>';
      }
      nav.innerHTML = html;
      nav.style.display = html ? "" : "none";

      document.title = d.titreCourt + " — M·Art";
      document.getElementById("focusBtn").title = t["o.zoom"];
    }

    // =============================================
    // LANGUE
    // =============================================
    function setLang(lang) {
      applyUI(lang);
      renderOeuvre(lang);
    }

    // =============================================
    // ONGLETS
    // =============================================
    document.querySelectorAll(".tab").forEach(function (btn) {
      btn.addEventListener("click", function () {
        document.querySelectorAll(".tab").forEach(function (b) { b.classList.remove("active"); });
        document.querySelectorAll(".tab-content").forEach(function (c) { c.classList.remove("active"); });
        btn.classList.add("active");
        document.getElementById("tab-" + btn.dataset.tab).classList.add("active");
      });
    });

    // =============================================
    // LIGHTBOX
    // =============================================
    const lightbox = document.getElementById("lightbox");
    function openLightbox() {
      lightbox.classList.add("open");
      document.body.style.overflow = "hidden";
    }
    function closeLightbox() {
      lightbox.classList.remove("open");
      document.body.style.overflow = "";
    }
    document.getElementById("focusBtn").addEventListener("click", openLightbox);
    document.getElementById("artImg").addEventListener("click", openLightbox);
    document.getElementById("lightboxClose").addEventListener("click", closeLightbox);
    lightbox.addEventListener("click", function (e) { if (e.target === lightbox) closeLightbox(); });
    document.addEventListener("keydown", function (e) { if (e.key === "Escape") closeLightbox(); });

    initChrome();
    initLangButtons(setLang);
    setLang(getLang());
  </script>
</body>
</html>
